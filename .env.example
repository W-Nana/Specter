# Specter Master 配置

# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Discord Guild ID（伺服器 ID）
GUILD_ID=123456789

# Agent 上下線通知頻道 ID
NOTIFY_CHANNEL_ID=987654321

# Agent HTTP API 監聽端口
API_PORT=8080

# 默認 relay 端口（反向隧道用）
DEFAULT_RELAY_PORT=8420

# 默認心跳間隔（秒）
DEFAULT_POLL_INTERVAL=10

# 數據庫路徑
DB_PATH=specter.db

# 日誌等級
LOG_LEVEL=INFO
